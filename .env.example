# 実際の値をGitに登録しないこと。.envの自動読み込みは行いません。
ADMIN_PASSWORD=replace-with-a-long-random-password
PORT=3000
# HTTPSのリバースプロキシで公開する際にproductionを設定
NODE_ENV=production

# 将来のSupabase接続用。実際の値はホスティングの秘密環境変数に登録。
# PostgreSQLは通常起動の既定。未設定・接続失敗なら起動を拒否します。
DATABASE_URL=

# ローカルSQLiteは明示的に選ぶ場合だけ使用。自動フォールバックはしません。
STORAGE_BACKEND=postgres
# 必要な場合のみ、公式CA証明書のファイルパスを指定（秘密鍵ではありません）。
# DATABASE_CA_CERT_PATH=

# private: 全ページをadmin/ADMIN_PASSWORDで保護。productionでは省略時もprivate。
# 一般公開を明示的に決めた場合だけpublicへ変更。
SITE_ACCESS=private
